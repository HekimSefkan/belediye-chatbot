# Bu dosyayı ".env" adıyla kopyalayıp değerleri değiştirin.
# .env dosyası .gitignore içindedir, GitHub'a yüklenmez.
# Hiçbir ayar zorunlu değildir; .env olmadan uygulama güvenli varsayılanlarla çalışır.

# Flask oturumlarını imzalamak için gizli anahtar.
# BOŞ BIRAKILIRSA uygulama rastgele bir anahtar üretip instance/secret_key dosyasına kaydeder (önerilen).
# Kendiniz belirleyecekseniz en az 32 karakterlik rastgele bir değer yazın; örnek üretmek için:
#   venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
# DİKKAT: Bu dosyadaki örnek metni olduğu gibi bırakmayın; herkese açık olduğu için yok sayılır.
SECRET_KEY=

# Admin paneli giriş bilgileri
# Uygulama her açıldığında bu bilgiler veritabanındaki admin kaydıyla eşitlenir
# (şifre veritabanına düz metin olarak değil, hash'lenerek yazılır; başka kullanıcı adıyla
# kalmış eski admin kayıtları silinir).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Chatbot benzerlik eşiği (0 ile 1 arası). Bu değerin altındaki eşleşmeler "cevap bulunamadı" sayılır.
SIMILARITY_THRESHOLD=0.35

# Debug modu: sadece geliştirirken True yapın. Açıkken hata sayfaları kaynak kodu ve dosya yollarını
# gösterir; demo ve gerçek kullanımda False kalmalıdır.
FLASK_DEBUG=False
PORT=5000
