# Bu dosyayı ".env" adıyla kopyalayıp değerleri değiştirin.
# .env dosyası .gitignore içindedir, GitHub'a yüklenmez.

# Flask oturumlarını imzalamak için gizli anahtar (uzun ve rastgele olmalı)
SECRET_KEY=buraya-uzun-ve-rastgele-bir-deger-yazin

# Admin paneli giriş bilgileri
# Uygulama her açıldığında bu bilgiler veritabanındaki admin kaydıyla eşitlenir
# (şifre veritabanına düz metin olarak değil, hash'lenerek yazılır).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Chatbot benzerlik eşiği (0 ile 1 arası). Bu değerin altındaki eşleşmeler "cevap bulunamadı" sayılır.
SIMILARITY_THRESHOLD=0.35

# Geliştirme modu (hata ayrıntılarını gösterir). Sunumda True kalabilir, gerçek ortamda False olmalı.
FLASK_DEBUG=True
PORT=5000
